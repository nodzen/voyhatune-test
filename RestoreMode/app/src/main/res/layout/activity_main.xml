<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <!-- ЛЕВАЯ КОЛОНКА: режимы вождения + рекуперация + энергия + автосвет -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <!-- Автосвет -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/layout_category_bg"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Автоматический ближний свет"
                        android:textColor="#ffffff"
                        android:textSize="24px" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="На автомобилях ОД С+ отключает матричный свет"
                        android:textColor="#888888"
                        android:textSize="19px" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchAutoLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:textColor="#ffffff"
                    android:textSize="24px"
                    android:textOff="Выкл"
                    android:textOn="Вкл"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />

            </LinearLayout>

            <TextView
                android:id="@+id/textSensorLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Датчик: —"
                android:textColor="#888888"
                android:textSize="22px"
                android:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <!-- ПРАВАЯ КОЛОНКА: кнопки вертикально, фиксированная ширина -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingStart="4dp"
        android:paddingEnd="5dp"
        android:paddingTop="5dp">

        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#373f4a"
            android:onClick="onButtonClickApply"
            android:text="Применить"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/button1"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#373f4a"
            android:onClick="onButtonClickClose"
            android:text="Закрыть"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/buttonAdvance"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:gravity="center"
            android:onClick="onButtonClickAdvance"
            android:text="Дополнительно"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

    </LinearLayout>

</LinearLayout>
