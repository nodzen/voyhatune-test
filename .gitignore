# Built application files
bind_dir.sh
copy_apk.sh
readme.md.backup
# Собранные APK никогда не коммитятся: сборочный вывод воспроизводится из исходников.
# Явное исключение — vendor-overlay, он часть исходника релиза.
*.apk
!Packaging/vendor-overlay/*.apk
*.aar
*.ap_
*.aab
# Files for the ART/Dalvik VM
*.dex
# Java class files
*.class
# Generated files
bin/
gen/
out/
# App Release Files
#app/release/*

#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/
# Gradle files
.gradle/
build/
# Local configuration file (sdk path, etc)
local.properties
# Proguard folder generated by Eclipse
proguard/
# Log Files
*.log
# Сырые захваты logcat/скриптов из Utils/log — рабочий мусор, а не исходники.
# Инструменты (readlog.sh, bcast_history.sh) остаются под контролем версий.
Utils/log/*
!Utils/log/readlog.sh
!Utils/log/bcast_history.sh
# Android Studio Navigation editor temp files
.navigation/
# Android Studio captures folder
captures/
# IntelliJ
*.iml
.idea/
# .idea/workspace.xml
# .idea/tasks.xml
# .idea/gradle.xml
# .idea/assetWizardSettings.xml
# .idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml
# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
*.jks
*.keystore
# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/
# Google Services (e.g. APIs or Firebase)
google-services.json
# Freeline
freeline.py
freeline/
freeline_project_description.json
# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md
# Version control
vcs.xml
# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/
# MacOS
.DS_Store
# App Specific cases
app/release/output.json
.idea/codeStyles/
tmp
CONTEXT.md
/vibe/

# Релизы — сборочный вывод, в репозитории не хранятся.
# Источник комплекта (инжект-скрипты, установщики, boot-обвязка, tools) — в Packaging/.
# Собрать: ./make_release.sh <версия>
/Releases/

# Локальный рабочий мусор: не содержимое репозитория и не источник для чего-либо.
# Снапшоты чужих релизов для сверки.
/VoyahTune-3.*/
# Диагностические захваты с автомобилей.
/collected/
/voyah-*-diag*
# Устаревший root-скрипт с путями с чужой машины; последняя версия в 15b68c8.
/push.sh

